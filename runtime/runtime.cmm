_pow (a, b) {
  var r;
  r = 1;

  if (b < 0) { return 1; }
  while (b > 0) {
    if b%2 == 1 {
      r = r*a;
    }
    a = a*a;
    b = b/2;
  }

  return r;
}

_mod (a, b) {
  return a - (a/b)*b;
}

_print(s) {
  var i, c;
  i = 0;
  do {
    c = $(s+i);
    i++;
    putc# c;
  } while (c != 0);
}

_len(s) {
  var l, c;
  while (true) {
    c = $(s+l);
    if (c == 0) { break; }
    l++;
  }
  return l;
}
