main {
  var a=10;
  const c=100;

  writeln# a;
  writeln# c;

  // writeln# @c; // できない
  // constの書き換え
  $4 = 200;
  writeln# c;
  f(4);
  writeln# c;
}

f(a) {
  $a = 123;
}

hello() {
  putc# 'H';
  putc# 'e';
  putc# 'l';
  putc# 'l';
  putc# 'o';
  putc# ',';
  putc# ' ';
  putc# 'W';
  putc# 'o';
  putc# 'r';
  putc# 'l';
  putc# 'd';
  putc# '!';
  putc# '!';
  putc# 10;
}
