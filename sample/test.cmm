main {
  hello();

  var msg[30];
  var l;

  msg = { 'H', 'e', 'l', 'l', 'o', 10, 0 };
  msg = "https://www.tus.ac.jp/";
  l = _len(@msg);
  msg[l] = 10;
  _print(@msg);

  writeln# time#;
}

f(a) {
  $a = 123;
}

hello() {
  putc# 'H';
  putc# 'e';
  putc# 'l';
  putc# 'l';
  putc# 'o';
  putc# ',';
  putc# ' ';
  putc# 'W';
  putc# 'o';
  putc# 'r';
  putc# 'l';
  putc# 'd';
  putc# '!';
  putc# '!';
  putc# 10;
}
