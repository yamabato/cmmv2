main {
  hello();

  var v;

  var arr[10];
  arr[0] = 987;
  arr[5] = 123;

  writeln arr[5];
  writeln @arr[5];

  f(@v);
  writeln v;

  writeln arr;
}

f(a) {
  $a = 123;
  return 1;
}

hello() {
  putc 'H';
  putc 'e';
  putc 'l';
  putc 'l';
  putc 'o';
  putc ',';
  putc ' ';
  putc 'W';
  putc 'o';
  putc 'r';
  putc 'l';
  putc 'd';
  putc '!';
  putc '!';
  putc 10;
}
