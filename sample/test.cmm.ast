FUNC DEF: _pow (a, b)
  BLOCK
    VAR:
      ID: r

    BINARY OPER: :=
      LEFT:
        ID: r
      RIGHT:
        INT: 1
    IF
      COND
        BINARY OPER: <
          LEFT:
            ID: b
          RIGHT:
            INT: 0

      BLOCK
        RETURN
          INT: 1

    WHILE
      COND
        BINARY OPER: >
          LEFT:
            ID: b
          RIGHT:
            INT: 0

      BLOCK
        IF
          COND
            BINARY OPER: ==
              LEFT:
                BINARY OPER: %
                  LEFT:
                    ID: b
                  RIGHT:
                    INT: 2
              RIGHT:
                INT: 1

          BLOCK
            BINARY OPER: :=
              LEFT:
                ID: r
              RIGHT:
                BINARY OPER: *
                  LEFT:
                    ID: r
                  RIGHT:
                    ID: a
        BINARY OPER: :=
          LEFT:
            ID: a
          RIGHT:
            BINARY OPER: *
              LEFT:
                ID: a
              RIGHT:
                ID: a
        BINARY OPER: :=
          LEFT:
            ID: b
          RIGHT:
            BINARY OPER: /
              LEFT:
                ID: b
              RIGHT:
                INT: 2
    RETURN
      ID: r


FUNC DEF: main ()
  BLOCK
    VAR:
      ID: n

    FOR
      INIT
        BINARY OPER: :=
          LEFT:
            ID: n
          RIGHT:
            INT: 0
      COND
        BINARY OPER: <
          LEFT:
            ID: n
          RIGHT:
            INT: 10
      INCR
        BINARY OPER: :=
          LEFT:
            ID: n
          RIGHT:
            BINARY OPER: +
              LEFT:
                ID: n
              RIGHT:
                INT: 1

      BLOCK
        UNARY OPER: WRITE
          RIGHT:
            ID: n
        UNARY OPER: WRITELN
          RIGHT:
VAR:


