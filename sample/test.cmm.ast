FUNC DEF: f (x, y)
  BLOCK
    RETURN
      BINARY OPER: +
        LEFT:
          ID: x
        RIGHT:
          BINARY OPER: *
            LEFT:
              ID: y
            RIGHT:
              ID: y


FUNC DEF: main ()
  BLOCK
    VAR:
      ID: n

    BINARY OPER: :=
      LEFT:
        ID: n
      RIGHT:
        INT: 0
    WHILE
      COND
        -*-UNSUPPORTED NODE KIND(6)-*-

      BLOCK
        BINARY OPER: :=
          LEFT:
            ID: n
          RIGHT:
            BINARY OPER: +
              LEFT:
                ID: n
              RIGHT:
                INT: 1
    UNARY OPER: WRITE
      RIGHT:
        ID: n
    UNARY OPER: WRITELN
      RIGHT:
    IF
      COND
        -*-UNSUPPORTED NODE KIND(6)-*-

      BLOCK
        UNARY OPER: WRITE
          RIGHT:
            ID: n
        UNARY OPER: WRITELN
          RIGHT:
    ELSE
      BLOCK
        UNARY OPER: WRITE
          RIGHT:
            INT: 121
        UNARY OPER: WRITELN
          RIGHT:
    IF
      COND
        -*-UNSUPPORTED NODE KIND(4)-*-

      BLOCK
        UNARY OPER: WRITE
          RIGHT:
            ID: n
        UNARY OPER: WRITELN
          RIGHT:

