FUNC DEF: f (x, y)
  BLOCK
    RETURN
      BINARY OPER: +
        LEFT:
          ID: x
        RIGHT:
          BINARY OPER: *
            LEFT:
              ID: y
            RIGHT:
              ID: y


FUNC DEF: main ()
  BLOCK
    VAR:
      ID: n

    BINARY OPER: :=
      LEFT:
        ID: n
      RIGHT:
        BINARY OPER: +
          LEFT:
            INT: 10
          RIGHT:
            CALL: f
              PARAMS:
                INT: 15
                INT: 20
                INT: 20
    UNARY OPER: WRITE
      RIGHT:
        ID: n
    UNARY OPER: WRITELN
      RIGHT:

