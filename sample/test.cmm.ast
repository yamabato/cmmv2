FUNC DEF: f (x, y)
  BLOCK
    RETURN
      BINARY OPER: +
        LEFT:
          ID: x
        RIGHT:
          BINARY OPER: *
            LEFT:
              ID: y
            RIGHT:
              ID: y


FUNC DEF: f (x, y)
  BLOCK
    RETURN
      BINARY OPER: +
        LEFT:
          ID: x
        RIGHT:
          BINARY OPER: *
            LEFT:
              ID: y
            RIGHT:
              ID: y


FUNC DEF: main ()
  BLOCK
    VAR:
      ID: n

    BINARY OPER: :=
      LEFT:
        ID: n
      RIGHT:
        INT: 10
    UNARY OPER: WRITE
      RIGHT:
        ID: n
    UNARY OPER: WRITELN
      RIGHT:

