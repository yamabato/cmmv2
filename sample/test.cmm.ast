FUNC DEF: f (x, y)
  BLOCK
    RETURN
      BINARY OPER: +
        LEFT:
          ID: x
        RIGHT:
          BINARY OPER: *
            LEFT:
              ID: y
            RIGHT:
              ID: y


FUNC DEF: main ()
  BLOCK
    VAR:
      ID: n

    UNARY OPER: READ
      RIGHT:
        ID: n
    UNARY OPER: WRITE
      RIGHT:
        BINARY OPER: +
          LEFT:
            ID: n
          RIGHT:
            INT: 10
    UNARY OPER: WRITELN
      RIGHT:

