// https://atcoder.jp/contests/abc087/tasks/abc087_b
main {
  var A, B, C, X;
  var a, b, c;
  var n = 0;

  A = read#;
  B = read#;
  C = read#;
  X = read#;

  for (a=0; a<=A; a++) {
    for (b=0; b<=B; b++) {
      for (c=0; c<=C; c++) {
        if (a*500+b*100+c*50 == X) { n++; }
      }
    }
  }

  writeln# n;
}
