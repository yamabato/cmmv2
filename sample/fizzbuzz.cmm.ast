FUNC DEF: _pow (a, b)
  BLOCK
    VAR:
      -*-UNSUPPORTED NODE KIND(36)-*-

    -*-UNSUPPORTED NODE KIND(39)-*-
    IF
      COND
        BINARY OPER: <
          LEFT:
            ID: b
          RIGHT:
            INT: 0

      BLOCK
        RETURN
          INT: 1

    WHILE
      COND
        BINARY OPER: >
          LEFT:
            ID: b
          RIGHT:
            INT: 0

      BLOCK
        IF
          COND
            BINARY OPER: ==
              LEFT:
                BINARY OPER: %
                  LEFT:
                    ID: b
                  RIGHT:
                    INT: 2
              RIGHT:
                INT: 1

          BLOCK
            -*-UNSUPPORTED NODE KIND(39)-*-
        -*-UNSUPPORTED NODE KIND(39)-*-
        -*-UNSUPPORTED NODE KIND(39)-*-
    RETURN
      ID: r


FUNC DEF: main ()
  BLOCK
    VAR:
      -*-UNSUPPORTED NODE KIND(36)-*-

    FOR
      INIT
        BINARY OPER: :=
          LEFT:
            ID: n
          RIGHT:
            INT: 1
      COND
        BINARY OPER: <=
          LEFT:
            ID: n
          RIGHT:
            INT: 100
      INCR
        BINARY OPER: -
          LEFT:
            BINARY OPER: :=
              LEFT:
                ID: n
              RIGHT:
                BINARY OPER: +
                  LEFT:
                    ID: n
                  RIGHT:
                    INT: 1
          RIGHT:
            INT: 1

      BLOCK
        UNARY OPER: WRITELN
          RIGHT:
            ID: n
VAR:
      BINARY OPER: :=
        LEFT:
          ID: n
        RIGHT:
          INT: 1


